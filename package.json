{
  "name": "node-red-contrib-dirigera-plus",
  "version": "1.0.1",
  "description": "Node-RED nodes for the IKEA DIRIGERA hub: control devices/rooms/scenes and receive live hub events (motion, buttons, open/close, state changes) via websocket.",
  "keywords": [
    "node-red",
    "dirigera",
    "ikea",
    "events",
    "websocket",
    "smart-home",
    "home-automation",
    "tradfri"
  ],
  "main": "dirigera.js",
  "scripts": {
    "pretest": "npm install node-red-node-test-helper node-red mocha --no-save",
    "test": "standard && mocha \"test/**/*.spec.js\"",
    "lint": "standard --fix"
  },
  "author": "xbln",
  "contributors": [
    "zinen (original node-red-contrib-dirigera)"
  ],
  "license": "MIT",
  "devDependencies": {
    "standard": "*"
  },
  "node-red": {
    "version": ">=3.0.0",
    "nodes": {
      "dirigera": "dirigera.js"
    }
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "dirigera.js",
    "dirigera.html",
    "examples/",
    "image/",
    "README.md",
    "LICENSE"
  ],
  "bugs": {
    "url": "https://github.com/xbln/node-red-contrib-dirigera-plus/issues"
  },
  "homepage": "https://github.com/xbln/node-red-contrib-dirigera-plus#readme",
  "dependencies": {
    "node-dirigera-promise": "^0.6.0",
    "ws": "^8.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xbln/node-red-contrib-dirigera-plus.git"
  }
}
